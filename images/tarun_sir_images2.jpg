<script type="module" src="https://cdnjs.cloudflare.com/ajax/libs/countup.js/2.6.0/countUp.min.js"></script>
<script>

    document.addEventListener("DOMContentLoaded", function () {
        const countupElements = document.querySelectorAll(".countup");

        countupElements.forEach(element => {
            const target = parseInt(element.getAttribute("data-target"), 10);
            let currentValue = 0; // Start from 0
            const increment = Math.ceil(target / 100); // Increment value for smoother animation
            const duration = 2000; // Duration in milliseconds
            const intervalTime = duration / (target / increment);

            const interval = setInterval(() => {
                currentValue += increment;
                if (currentValue >= target) {
                    currentValue = target; // Ensure we stop at the target value
                    clearInterval(interval);
                }
                element.textContent = currentValue.toLocaleString(); // Update the DOM
            }, intervalTime);
        });
    });

</script>

<script>
    const video = document.getElementById('myVideo');
    const poster = document.getElementById('videoPoster');
    const playButton = document.getElementById('playButton');

    poster.addEventListener('click', () => {

        poster.style.display = 'none';
        playButton.style.display = 'none';

        video.play();
    });

    video.addEventListener('ended', () => {
        poster.style.display = 'block';
        playButton.style.display = 'block';
    });
</script>

</html>