<script type="text/javascript">
    itro_cookie_expiration = 0;
    itro_is_preview = false;
    auto_margin = "yes";
    jQuery('#ipp_mobile_close_txt').css({
        color: itro_invert_color(itro_rgb2hex(jQuery('#itro_popup').css('border-bottom-color')))
    });
    itro_age_restriction = false;
    document.onkeydown = function(event) {
        event = event || window.event;
        var key = event.keyCode;
        if (key == 27) {
            jQuery("#itro_popup").fadeOut(function() {
                jQuery("#itro_opaco").fadeOut();
            });

        }

    };
    itro_enter_anim(auto_margin);


    function openPopup() {
        document.getElementById("itro_popup").style.display = "block";
    }

    function closePopup() {
        document.getElementById("itro_popup").style.display = "none";
    }

    function open_inq() {
        // Since the user manually clicks, ignore cookie check and show popup
        var auto_margin = 'yes'; // You can set it to 'no' if alignment isn't needed
        itro_is_preview = true; // Set preview mode to true to bypass cookie check
        itro_enter_anim(auto_margin); // Trigger the popup display
    }

    /*  */
    itro_exit_anim();


    function itro_enter_anim(auto_margin) {
        // Check if popup cookie is not set or it's in preview mode
        if (document.cookie.indexOf("popup_cookie") == -1 || itro_is_preview === true) {
            // Align the popup before fade-in
            if (auto_margin == 'yes') {
                itro_margin_refresh(50);
            }
            jQuery("#itro_popup").css('display', 'none');
            jQuery("#itro_popup").css('opacity', 1);
            jQuery("#itro_popup").css('visibility', 'visible');
            jQuery("#itro_opaco").fadeIn(function() {
                jQuery("#itro_popup").fadeIn();
                // Set cookie for 24 hours (1 day)
                if (itro_age_restriction === false) {
                    itro_set_cookie("popup_cookie", "one_time_popup", 24); // Set for 24 hours
                }
                // Refresh every 0.5 second the popup top margin (needed for browser window resizing)
                if (auto_margin == 'yes') {
                    setInterval(function() {
                        itro_margin_refresh();
                    }, 500);
                }
            });
        } else {
            // Hide the popup if cookie exists
            jQuery("#itro_popup").css('display', 'none');
        }
    }

    $(document).ready(function() {
        document.getElementById('openPopupBtn').addEventListener('click', function() {
            document.getElementById('popup-reg').style.display = 'block'; // Show the popup
        });
        $('.popup-btn').click(function() {
            var popupBlock = $('#' + $(this).data('popup'));
            popupBlock.addClass('active')
                .find('.fade-out').click(function() {
                    popupBlock.css('opacity', '0').find('.popup-content').css('margin-top', '350px');
                    setTimeout(function() {
                        $('.popup').removeClass('active');
                        popupBlock.css('opacity', '').find('.popup-content').css('margin-top',
                            '');
                    }, 600);
                });
        });
    });

    function whatsappinquiry() {

        var subscribe_name = $("#name").val();
        var subscribe_phone = $("#phone").val();

        var phoneReg = /^\d{10}$/;
        if (subscribe_name == "") {

            $("#subscribe_err_popup").show();
            $("#subscribe_err_popup").css("color", "red");
            $("#name").focus();
            $("#subscribe_err_popup").html("Warning : Please Enter Your Name");
            setTimeout(function() {
                $("#subscribe_err_popup").hide();
            }, 30000);

        } else if (subscribe_phone == "" || phoneReg.test(subscribe_phone) == false) {
            $("#subscribe_err_popup").show();
            $("#subscribe_err_popup").css("color", "red");
            $("#phone").focus();
            $("#subscribe_err_popup").html("Warning : Please Enter a Valid 10-digit Phone Number");
            setTimeout(function() {
                $("#subscribe_err_popup").hide();
            }, 3000);
        } else {
            jQuery.ajax({
                type: "POST",
                data: {
                    subscribe_name: subscribe_name,
                    subscribe_phone: subscribe_phone
                },
                url: "/ajaxfiles/subscribe_process.php",
                success: function(response) {
                    if (response.trim() == "ok" || response.trim() == "ok1") {
                        $("#subscribe_err_popup").show();
                        $("#subscribe_err_popup").css("color", "green");
                        $("#name").focus();
                        $("#subscribe_err_popup").html("Success: Thank You For Joining");
                        setTimeout(function() {
                            $("#subscribe_err_popup").hide();
                        }, 3000);
                        $("#name").val("");
                        $("#phone").val("");
                        setTimeout(function() {
                            document.getElementById('popup-reg').style.display = 'none';
                            window.location.href =
                                "https://wa.me/6352177288?text=I'm%20inquiring%20about%20the%20Ajmera Trends";
                        }, 500);
                    } else if (response.trim() == "exist") {
                        $("#subscribe_err_popup").show();
                        $("#subscribe_err_popup").css("color", "red");
                        $("#phone").focus();
                        $("#subscribe_err_popup").html("Warning: you are already Joined");
                        setTimeout(function() {
                            $("#subscribe_err_popup").hide();
                        }, 3000);


                    }

                }

            });
        }
    }
</script>
<script>
    window.addEventListener('load', function() {
        document.getElementById('submitBtn').disabled = false;
    });

    function restrictNumber(e) {
        var newValue = this.value.replace(new RegExp(/[^\d]/, 'ig'), "");
        this.value = newValue;
    }
    var userName = document.querySelector('#admissionsenquiries-phone');
    var userpincode = document.querySelector('#admissionsenquiries-address_line_3');
    userName.addEventListener('input', restrictNumber);
    userpincode.addEventListener('input', restrictNumber);

    function franchise_inquiryform() {
        var name = $('#admissionsenquiries-name').val();
        var textMobileNo = $('#admissionsenquiries-phone').val();
        var city = $('#admissionsenquiries-address_line_1').val();
        var state = $('#admissionsenquiries-address_line_2').val();
        var pincode = $('#admissionsenquiries-address_line_3').val();
        /* console.log(pincode, 'pincode'); */
        if (name == '') {
            alert("Name Should Not Be Empty");
            return false;
        } else if (city == '') {
            alert("City Should Not Be Empty");
            return false;
        } else if (state == '') {
            alert("State Should Not Be Empty");
            return false;
        } else if (pincode == '') {
            alert("Pincode Should Not Be Empty");
            return false;
        } else if (textMobileNo == "") {
            alert("Enter Phone Number");
            return false;
        } else if (textMobileNo != "" && textMobileNo.length != "10") {
            alert("Phone number must be 10 digit");
            return false;
        } else {
            $.ajax({
                type: "POST",
                url: "ajaxfiles/franchise_process.php",
                dataType: "json",
                headers: {
                    "X-Requested-With": "XMLHttpRequest"
                },
                data: {
                    name: name,
                    city: city,
                    state: state,
                    pincode: pincode,
                    contact_mobileno: textMobileNo
                },
                success: function(data) {
                    if (data.status == "ok") {
                        alert(data.msg);
                        location.reload();
                    } else {
                        alert(data.msg);
                    }
                },

            });

        }
    }
</script>    <a href="#top" id="back-to-top" class="scrollto"><i class="fa fa-arrow-up"></i>Back to Top</a>



